{
	"name": "@prc/block-library",
	"version": "4.0.0",
	"description": "PRC Block Library",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "npm run build:library",
		"build:block": "node bin/build-block.js",
		"build:library": "wp-scripts build --webpack-copy-php && wp-scripts build --experimental-modules --webpack-copy-php && wp-scripts build-blocks-manifest && npm run build:deprecated",
		"build:manifest": "wp-scripts build-blocks-manifest",
		"build:core": "node bin/build-block.js core",
		"build:core-manifest": "wp-scripts build-blocks-manifest --input=./core-blocks/src --output=./core-blocks/build/blocks-manifest.php",
		"build:deprecated": "node bin/build-block.js deprecated",
		"build:deprecated-manifest": "wp-scripts build-blocks-manifest --input=./deprecated/src --output=./deprecated/build/blocks-manifest.php",
		"start:library": "wp-scripts build-blocks-manifest; wp-scripts start --experimental-modules --webpack-copy-php;",
		"build:block-visibility": "npm -w @prc/block-library-block-visibility run build",
		"build:interactivity-api": "npm -w @prc/block-library-interactivity-api run build",
		"build:pagination": "npm -w @prc/block-library-pagination run build",
		"build:supports": "npm -w @prc/block-library-supports run build",
		"build:print-engine": "npm -w @prc/block-library-print-engine run build",
		"start": "node bin/start-block.js",
		"watch": "node bin/start-block.js",
		"test": "wp-scripts test-unit-js --config jest.config.js",
		"composer": "vip dev-env exec --slug prc-platform -- composer --working-dir=/wp/wp-content/plugins/prc-block-library"
	},
	"devDependencies": {
		"@wordpress/scripts": "^31.4.0",
		"axios": "^1.7.7",
		"chalk": "4.1.2",
		"fs-extra": "^11.2.0",
		"glob": "^11.0.0",
		"path": "^0.12.7",
		"prompts": "^2.4.2",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^7.0.2",
		"@emotion/react": "^11.13.3",
		"@emotion/styled": "^11.13.0",
		"@prc/components": "*",
		"@prc/controls": "*",
		"@prc/functions": "*",
		"@prc/hooks": "*",
		"@prc/icons": "*",
		"@splidejs/splide": "^4.1.4",
		"@splidejs/splide-extension-intersection": "^0.2.0",
		"@wordpress/icons": "^10.22.0",
		"clsx": "^2.1.1",
		"comma-separated-values": "^3.6.4",
		"highlight.js": "^11.11.1",
		"hls.js": "^1.6.2",
		"html2pdf.js": "^0.12.1",
		"iframe-resizer": "^4.3.2",
		"md5": "^2.3.0",
		"mediaelement": "^7.0.7",
		"react-highlight": "^0.15.0",
		"react-player": "^2.16.0",
		"turndown": "^7.2.0"
	}
}
