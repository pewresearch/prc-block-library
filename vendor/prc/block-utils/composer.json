{
  "name": "prc/block-utils",
  "version": "1.1.0",
  "description": "Shared PHP block utilities for the PRC Platform: classNames, block-attribute helpers, find_block(s), spacing/gap helpers, and a sliding-window pagination renderer.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "dougsisk/laravel-country-state": "^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^1.1",
    "wp-phpunit/wp-phpunit": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "PRC\\BlockUtils\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "PRC\\BlockUtils\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "extra": {
    "branch-alias": {
      "dev-main": "1.1.x-dev"
    }
  }
}
