<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	>
	<testsuites>
		<testsuite name="unit">
			<directory suffix=".php">./tests/block-utils/unit/</directory>
			<directory suffix=".php">./tests/delayed-action/</directory>
			<directory suffix=".php">./tests/url-helper/unit/</directory>
			<directory suffix=".php">./tests/term-data-store/unit/</directory>
			<exclude>./tests/delayed-action/FakeScheduler.php</exclude>
		</testsuite>
		<testsuite name="integration">
			<directory suffix=".php">./tests/block-utils/integration/</directory>
			<directory suffix=".php">./tests/url-helper/integration/</directory>
			<directory suffix=".php">./tests/term-data-store/integration/</directory>
		</testsuite>
		<testsuite name="html">
			<directory suffix=".php">./tests/html/</directory>
		</testsuite>
	</testsuites>
	<coverage processUncoveredFiles="true">
		<include>
			<directory suffix=".php">./src</directory>
		</include>
		<exclude>
			<directory>./tests</directory>
			<directory>./vendor</directory>
		</exclude>
	</coverage>
	<php>
		<ini name="error_reporting" value="32767"/>
		<ini name="display_errors" value="1"/>
	</php>
</phpunit>
