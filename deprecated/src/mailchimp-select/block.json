{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "prc-block/mailchimp-select",
	"version": "1.0.0",
	"title": "MailChimp Select",
	"description": "Select from multiple MailChimp segment interests to subscribe to.",
	"category": "marketing",
	"keywords": ["mailchimp", "newsletters", "select"],
	"allowedBlocks": ["core/group", "prc-block/form"],
	"attributes": {
		"interests": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"inserter": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": {
				"sides": ["vertical"]
			}
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true
		},
		"interactivity": true
	},
	"example": {
		"innerBlocks": [
			{
				"name": "prc-block/form",
				"attributes": {
					"namespace": "prc-block/mailchimp-select",
					"action": "subscribe",
					"interactiveNamespace": "prc-block/mailchimp-form"
				},
				"innerBlocks": [
					{
						"name": "prc-block/form-input-text",
						"attributes": {
							"label": "Email Address",
							"required": true,
							"placeholder": "Email Address",
							"type": "email",
							"metadata": {
								"name": "emailAddress"
							}
						}
					},
					{
						"name": "prc-block/form-submit",
						"innerBlocks": [
							{
								"name": "core/button",
								"attributes": {
									"text": "Submit",
									"tagName": "button",
									"type": "submit"
								}
							},
							{
								"name": "prc-block/form-captcha",
								"attributes": {}
							}
						]
					},
					{
						"name": "prc-block/form-message",
						"innerBlocks": [
							{
								"name": "core/paragraph",
								"attributes": {
									"content": "Thank you for subscribing!"
								}
							}
						]
					}
				]
			}
		]
	},
	"textdomain": "mailchimp-select",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view/index.js"
}
