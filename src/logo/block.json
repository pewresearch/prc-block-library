{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "prc-block/logo",
	"version": "1.0.0",
	"title": "Pew Research Center Logo",
	"description": "The Pew Research Center logo, available in primary, alternate, decoded, and symbol styles. Dark mode aware.",
	"category": "theme",
	"keywords": ["logo", "masthead", "dark-mode"],
	"attributes": {
		"justification": {
			"type": "string",
			"default": "left",
			"enum": ["left", "center", "right"]
		},
		"width": {
			"type": "number",
			"default": 361
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": false,
			"gradients": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"styles": [
		{
			"name": "primary-only",
			"label": "Primary",
			"isDefault": true
		},
		{
			"name": "primary-stable-white",
			"label": "Primary (Stable White)"
		},
		{
			"name": "alt-only",
			"label": "Alternate"
		},
		{
			"name": "alt-stable-white",
			"label": "Alternate (Stable White)"
		},
		{
			"name": "symbol-only",
			"label": "Symbol Only"
		},
		{
			"name": "symbol-stable-white",
			"label": "Symbol (Stable White)"
		},
		{
			"name": "decoded-only",
			"label": "Decoded"
		}
	],
	"example": {
		"viewportWidth": 400,
		"attributes": {
			"width": 300,
			"className": "is-style-logo-example"
		}
	},
	"usesContext": ["postType", "postId", "queryId"],
	"textdomain": "pewresearch-logo",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"script": ["prc-icons"],
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css"
}
